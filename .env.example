# Copy to .env.local and fill in. Only VITE_-prefixed vars are exposed to the browser.

# Web3Forms access key for the contact form (Phase 5). Get one at https://web3forms.com
VITE_WEB3FORMS_KEY=

# Show the sample course fixtures in a production build (preview only). Never set in Vercel.
VITE_SAMPLE_CONTENT=
